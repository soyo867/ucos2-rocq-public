-    if (OSLockNesting > 0u) {                           /* Remove context switch lock                  */
+    if ((lock_added == OS_TRUE) && (OSLockNesting > 0u)) { /* Release only this call's added lock        */
         OSLockNesting--;
     }
     OSTaskDelHook(ptcb);                                /* Call user defined hook                      */
