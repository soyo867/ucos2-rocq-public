+/* The permanent task slot is the greatest owner alias. Mutex boosts only
+ * add lower-numbered aliases; releasing a mutex removes only its own alias.
+ * These helpers require the owner-use/lifetime protocol documented with the
+ * source variant. They neither inspect private Event nodes nor change ABI.
+ */
+static  INT8U OSMutex_BasePrio(OS_TCB *ptcb)
+{
+    INT16U i;
+    INT8U prio = ptcb->OSTCBPrio;
+
+    for (i = 0u; i <= OS_LOWEST_PRIO; i++) {
+        if (OSTCBPrioTbl[i] == ptcb) {
+            prio = (INT8U)i;
+        }
+    }
+    return prio;
+}
+
+static  INT8U OSMutex_EffectivePrio(OS_TCB *ptcb)
+{
+    INT16U i;
+
+    for (i = 0u; i <= OS_LOWEST_PRIO; i++) {
+        if (OSTCBPrioTbl[i] == ptcb) {
+            return (INT8U)i;
+        }
+    }
+    /* Outside the stated invariant this fallback is literal raw behavior,
+     * not a claim that a missing permanent slot is a valid kernel state. */
+    return ptcb->OSTCBPrio;
+}
